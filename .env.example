# Everest Auth - Environment Variables
# Copie este arquivo para .env.local e preencha os valores

# ==========================================
# API Configuration
# ==========================================
# URL do backend API (quando tiver backend real)
# NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ==========================================
# Authentication
# ==========================================
# Secret para JWT (apenas para backend)
# JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Tempo de expiração do access token (segundos)
# JWT_EXPIRES_IN=3600

# Tempo de expiração do refresh token (dias)
# REFRESH_TOKEN_EXPIRES_IN=30

# ==========================================
# Database (para backend)
# ==========================================
# DATABASE_URL=postgresql://user:password@localhost:5432/everest_auth

# ==========================================
# Email Service (para recuperação de senha)
# ==========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@evereste.com

# ==========================================
# External Auth Providers (opcional)
# ==========================================
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# ==========================================
# Analytics & Monitoring
# ==========================================
# VERCEL_ANALYTICS_ID=your-vercel-analytics-id
# SENTRY_DSN=your-sentry-dsn

# ==========================================
# Development
# ==========================================
# NODE_ENV=development
# NEXT_TELEMETRY_DISABLED=1